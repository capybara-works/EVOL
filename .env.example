# Database
DATABASE_URL=sqlite:///./evol.db

# GitHub Personal Access Token (required for GitHub Collector)
GITHUB_TOKEN=your_github_pat_here

# WebUI Authentication (optional - if not set, authentication is disabled)
# Uncomment and set these to enable Basic authentication for WebUI
# EVOL_UI_USERNAME=admin
# EVOL_UI_PASSWORD=your_secure_password_here

# Collector Settings
# EVOL_RETAIN_BINARIES=false
